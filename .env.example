# GEMINI_API_KEY: Required for Gemini AI API calls (Server / Supabase Edge Function).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: Backend endpoint for Scope Audit (e.g. Supabase Edge Function URL for GitHub Pages build).
# Defaults to /api/audit when running locally.
VITE_API_URL="https://your-project-ref.supabase.co/functions/v1/audit"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
